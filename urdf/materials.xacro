<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot Colors -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

</robot>
