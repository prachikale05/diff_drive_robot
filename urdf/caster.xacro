<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Caster Dimensions -->
  <xacro:property name="caster_radius" value="0.025"/>

  <!-- Caster Link -->
  <link name="caster_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia
          ixx="0.0001"
          ixy="0"
          ixz="0"
          iyy="0.0001"
          iyz="0"
          izz="0.0001"/>
    </inertial>

  </link>

  <!-- Fixed Joint -->
  <joint name="caster_joint" type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <!-- Rear bottom of the robot -->
    <origin xyz="-0.11 0 0.025" rpy="0 0 0"/>

  </joint>

</robot>
